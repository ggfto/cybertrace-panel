# ============================================================
# Copie para .env e preencha. Nada de configuracao mora no compose.
#   cp .env.example .env
# ============================================================

# --- identidade do stack ---------------------------------------------------
# Prefixo dos containers e nome do projeto, da rede e dos volumes. Troque para
# rodar mais de uma instancia no mesmo host sem colisao.
STACK_NAME=cybertrace

# --- imagem ----------------------------------------------------------------
CYBERTRACE_IMAGE=ghcr.io/ggfto/cybertrace-panel
# latest-web  -> painel no navegador (ttyd + Chromium, todas as opcoes)
# Fixe numa versao (ex.: 2.6.0-web) para deploy reproduzivel.
CYBERTRACE_TAG=latest-web

# Porta interna do ttyd. Nao e publicada no host — so o tunnel a alcanca.
APP_PORT=7681

RESTART_POLICY=unless-stopped

# --- ttyd ------------------------------------------------------------------
TTYD_MAX_CLIENTS=5
TTYD_TITLE=Cybertrace Panel

# Basic auth do proprio ttyd, no formato usuario:senha.
# Opcional, mas recomendado como segunda camada alem do Cloudflare Access.
# Deixe vazio para desligar.
TTYD_CREDENTIAL=

# --- cloudflare ------------------------------------------------------------
# O tunnel e criado pela API na primeira subida; nao ha nada a fazer no painel.
# O token precisa de dois escopos:
#   Account > Cloudflare Tunnel : Edit
#   Zone    > DNS               : Edit  (na zona do APP_HOSTNAME)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# Hostname publico. O CNAME proxied e criado automaticamente.
APP_HOSTNAME=ct.gf2.in

# Um tunnel por stack — precisa ser unico na conta.
TUNNEL_NAME=cybertrace

CF_TUNNEL_INIT_TAG=latest
CLOUDFLARED_TAG=latest

# --- opcionais do painel ---------------------------------------------------
# Credenciais do rastreio de encomendas (https://linketrack.com)
LINKETRACK_USER=
LINKETRACK_TOKEN=
