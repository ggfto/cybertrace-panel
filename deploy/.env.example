# ============================================================
# Copie para .env e preencha. Nada de configuracao mora no compose.
#   cp .env.example .env
# ============================================================

# --- identidade do stack ---------------------------------------------------
# Prefixo dos containers e nome do volume. Troque para rodar mais de uma
# instancia no mesmo host sem colisao.
STACK_NAME=cybertrace

# --- imagem ----------------------------------------------------------------
CYBERTRACE_IMAGE=ghcr.io/ggfto/cybertrace-panel
# latest-web  -> painel no navegador (ttyd + Chromium, todas as opcoes)
# Fixe numa versao (ex.: 2.5.2-web) para deploy reproduzivel.
CYBERTRACE_TAG=latest-web

# Porta interna do ttyd. Nao e publicada no host — so o tunnel a alcanca.
APP_PORT=7681

RESTART_POLICY=unless-stopped

# --- ttyd ------------------------------------------------------------------
TTYD_MAX_CLIENTS=5
TTYD_TITLE=Cybertrace Panel

# Basic auth do proprio ttyd, no formato usuario:senha.
# Opcional, mas recomendado como segunda camada alem do Cloudflare Access.
# Deixe vazio para desligar.
TTYD_CREDENTIAL=

# --- cloudflare tunnel -----------------------------------------------------
# Token do tunnel (Zero Trust > Networks > Tunnels > seu tunnel > token).
# Obrigatorio: o compose falha na hora se estiver vazio.
TUNNEL_TOKEN=

# Hostname publico. NAO e lido pelo compose: com tunnel por token o ingress
# mora na Cloudflare. Fica aqui como documentacao de para onde este stack
# responde — configure o mapeamento uma vez no painel:
#   ${APP_HOSTNAME}  ->  http://<STACK_NAME>-painel:<APP_PORT>
APP_HOSTNAME=ct.gf2.in

CLOUDFLARED_TAG=latest
TUNNEL_METRICS_PORT=2000

# --- opcionais do painel ---------------------------------------------------
# Credenciais do rastreio de encomendas (https://linketrack.com)
LINKETRACK_USER=
LINKETRACK_TOKEN=
